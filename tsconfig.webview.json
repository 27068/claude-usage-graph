{
  // Type-checks the webview client only. esbuild does the bundling and does not
  // type-check, so this pass is what keeps the browser-side code honest.
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "ES2020",
    "lib": ["ES2021", "DOM"],

    // The browser bundle needs no ambient @types packages: DOM comes from lib,
    // and Chart.js ships its own types.
    "types": [],

    "noEmit": true,
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  // Only the client entry points. TypeScript follows their imports, so the
  // checked graph is exactly what reaches the browser — the pure selector and
  // formatting modules, and none of the Node-only core (fs, path, process).
  "include": ["src/webview/client/**/*.ts"]
}
